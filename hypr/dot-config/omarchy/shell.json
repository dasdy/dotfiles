{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd, MMMM dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "dasd.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [
            "nm-applet",
            "proton.vpn.app.gtk",
            "qBittorrent",
            "chrome_status_icon_1",
            "steam"
          ],
          "hidden": []
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 86400,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "dasd.display-off"
    }
  ],
  "version": 1
}
